# Copy to .env (repo root). Never commit .env.

# ── server (local `npm run dev`) ──
PORT=5000
MONGO_URI=mongodb://localhost:27017/sifguard
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated list of allowed browser origins
CLIENT_ORIGIN=http://localhost:5173,https://sif-guard-gamma.vercel.app
ML_SERVICE_URL=http://localhost:8000
NOTIFY_THRESHOLD=0.85
# Same-site (local / Vercel rewrite): lax + false.  Cross-site HTTPS deploy: none + true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── docker compose only ──
# http://ml-service:8000 (real) or http://mock-ml:8000 (mock, with --profile mock or naming mock-ml)
DOCKER_ML_SERVICE_URL=http://ml-service:8000

# ── client (sif-guard-client/.env) ──
VITE_API_URL=http://localhost:5000/api
VITE_USE_MOCK=false
